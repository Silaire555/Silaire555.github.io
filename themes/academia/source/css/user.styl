// 从 Google Fonts 引入思源宋体
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700&display=swap');

// 保持全局字体为宋体（你之前的设置）
html, body, #body-wrap, .main-content
  font-family: "Noto Serif SC", "SimSun", "宋体", serif !important

// 重新定义根字号为 15px（可选，让 rem 整体变小）
html
  font-size: 15px

// 按照层级设置更小的字号（比主题默认小很多）
h1
  font-size: 2.5rem !important       // 原 3rem → 2rem


h2
  font-size: 2.2rem !important     // 原 2.8rem → 1.8rem
  margin-top:6rem

h3
  font-size: 2rem !important     // 原 2.6rem → 1.6rem

p, li, .post-content
  font-size: 1.3rem !important       // 原 1.8rem → 1rem

// 页面的标题（比如分类页、归档页）
.page-title
  font-size: 2rem !important

/* 去掉顶部和底部的分割线 */
header#page_header,
footer#page_footer,
.nav-wrap,
.side-card,
#page_main > .page {
  border-top: none !important;
  border-bottom: none !important;
  box-shadow: none !important;
}

/* 有时候分割线可能是伪元素 (::before / ::after) 或 hr 标签 */
header::before, header::after,
footer::before, footer::after,
hr {
  display: none !important;
}

/* 自定义主题配色：黑底白字 */
/* 网页主体背景设为透明，以透出你的银河特效 */
body {
  background-color: #171628 !important; /* 关键！让银河背景透出来 */
  background-image: url('/images/nebula.jpg');
  background-size: cover;
  background-attachment: fixed;   /* 固定背景，不滚动 */
  background-position: center;
  background-repeat: no-repeat;
  color: #f3f3f3 !important; /* 全局文字设为白色 */
}

/* 确保所有文本都显示为白色 */
body, p, h1, h2, h3, h4, h5, h6, li, a, .post-content, .article-content {
  color: #f3f3f3 !important;
  margin: 0 0 1 0;
}

/* 全局链接样式：除了白色，还可以加个悬停效果 */
a {
  color: #f3f3f3 !important; /* 链接默认白色 */
  text-decoration: none;
}
a:hover {
  text-decoration: underline; /* 悬停时显示下划线，也可以改为其它颜色 */
}
.post-meta {
  color: #cccccc !important; /* 元信息（日期、分类）用浅灰色，比纯白柔和 */
}

/* 让主要内容区域的背景变透明，以展示银河 */
.post-block, .post, .article, .page, .card, .side-card, .page-main, #page_main, .container {
  background-color: transparent !important; /* 卡片和内容区域背景变透明 */
  box-shadow: none !important; /* 去掉可能有的阴影 */
}

/* 侧边栏也变透明 */
.side-card, .sidebar, .widget {
  background-color: transparent !important;
  border: none !important;
}

/* 底部版权信息区域 */
footer, #page_footer, .footer {
  background-color: transparent !important;
  color: #aaaaaa !important;
}

/* 如果你有代码块，可以设置一下背景和文字 */
pre, code {
  background-color: rgba(0, 0, 0, 0.5) !important; /* 半透黑底，保证代码可读 */
  color: #eee !important;
}




